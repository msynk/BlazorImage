<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>BlazorImage.Editor</RootNamespace>
    <AssemblyName>BlazorImage.Editor</AssemblyName>
    <PackageId>BlazorImage.Editor</PackageId>
    <Description>A themeable, accessible, touch-friendly Blazor image editor component built on BlazorImage: crop, rotate, adjust, filter, draw, annotate, redact, undo/redo and export.</Description>
    <StaticWebAssetBasePath Condition="'$(StaticWebAssetBasePath)' == ''">_content/BlazorImage.Editor</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BlazorImage.Blazor/BlazorImage.Blazor.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>
</Project>
