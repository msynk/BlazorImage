@page "/batch"
@implements IDisposable
@inject ImageProcessorFactory Processors
@inject ImageExporter Exporter
@inject IImageCapabilityProvider Capabilities

<PageTitle>Batch processor — BlazorImage</PageTitle>

<div class="page-header">
    <h1>Batch processor</h1>
    <p class="lede">
        The same pipeline over many files with bounded concurrency, live progress, cancellation, and a per-file result
        rather than one failure aborting the run. This is the headless batch API driving a UI, not a separate code path.
    </p>
</div>

@if (_error is not null)
{
    <div class="alert alert-error" role="alert">@_error</div>
}

<div class="split">
    <div class="card">
        <ImageDropZone Label="Drop several images here" Multiple="true" MaxFiles="200" OnFilesSelected="OnFilesSelected" />

        @if (_running || _result is not null)
        {
            <div style="margin-top:16px">
                <div class="progress" role="progressbar" aria-valuenow="@_completed" aria-valuemin="0" aria-valuemax="@_total">
                    <div class="progress-bar" style="width:@(_total == 0 ? 0 : _completed * 100 / _total)%"></div>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px">
                    <span class="small muted">@_completed of @_total</span>
                    @if (_running)
                    {
                        <button class="btn" style="height:26px; padding:0 10px" @onclick="Cancel">Stop</button>
                    }
                </div>
            </div>
        }

        @if (_result is not null)
        {
            <div class="stat-grid" style="margin-top:18px">
                <div class="stat">
                    <span class="stat-label">Succeeded</span>
                    <span class="stat-value good">@_result.SuccessCount</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Failed</span>
                    <span class="stat-value" style="@(_result.FailureCount > 0 ? "color:var(--danger)" : "")">@_result.FailureCount</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Input</span>
                    <span class="stat-value">@Format(_result.TotalInputBytes)</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Output</span>
                    <span class="stat-value">@Format(_result.TotalOutputBytes)</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Elapsed</span>
                    <span class="stat-value">@_result.Duration.TotalSeconds.ToString("0.0")s</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Per image</span>
                    <span class="stat-value">@((_result.Results.Count == 0 ? 0 : _result.Duration.TotalMilliseconds / _result.Results.Count).ToString("0"))ms</span>
                </div>
            </div>

            <table class="data" style="margin-top:16px">
                <thead>
                    <tr>
                        <th scope="col">File</th>
                        <th scope="col">Result</th>
                        <th scope="col" class="num">In</th>
                        <th scope="col" class="num">Out</th>
                        <th scope="col" class="num">Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _result.Results)
                    {
                        <tr>
                            <td>@(item.FileName ?? "—")</td>
                            <td>
                                @if (item.IsSuccess)
                                {
                                    <span class="badge badge-yes">@item.Output!.Width×@item.Output.Height @item.Output.Format.ToString().ToUpperInvariant()</span>
                                }
                                else if (item.WasCancelled)
                                {
                                    <span class="badge">stopped</span>
                                }
                                else
                                {
                                    <span class="badge badge-no">@Describe(item.Error!)</span>
                                }
                            </td>
                            <td class="num">@Format(item.Item.Data.Length)</td>
                            <td class="num">@(item.Output is null ? "—" : Format(item.Output.Length))</td>
                            <td class="num">@item.Duration.TotalMilliseconds.ToString("0")ms</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="btn-row" style="margin-top:14px">
                <button class="btn btn-primary" disabled="@_running" @onclick="DownloadAll">Download results</button>
            </div>
        }
    </div>

    <div class="card">
        <p class="card-title">Pipeline</p>

        <div class="field">
            <label class="field-label" for="edge">Longest edge <span class="field-value">@_maxEdge px</span></label>
            <input id="edge" type="range" min="240" max="3840" step="80" value="@_maxEdge" @oninput="e => SetInt(ref _maxEdge, e)" />
        </div>

        <div class="field">
            <label class="field-label" for="conc">Concurrency <span class="field-value">@_concurrency</span></label>
            <input id="conc" type="range" min="1" max="8" step="1" value="@_concurrency" @oninput="e => SetInt(ref _concurrency, e)" />
            <span class="small muted">Each worker holds a decoded image, so this is a memory dial as much as a speed dial.</span>
        </div>

        <div class="field">
            <label class="field-label" for="bformat">Format</label>
            <select id="bformat" class="bi-select" @onchange="OnFormatChanged">
                @foreach (var format in AvailableFormats)
                {
                    <option value="@format" selected="@(_format == format)">@format.ToString().ToUpperInvariant()</option>
                }
            </select>
        </div>

        <div class="field field-inline">
            <input id="grayscale" type="checkbox" checked="@_grayscale" @onchange="e => _grayscale = (bool)(e.Value ?? false)" />
            <label class="field-label" for="grayscale" style="margin:0">Convert to grayscale</label>
        </div>

        <div class="field field-inline">
            <input id="stopfirst" type="checkbox" checked="@_stopOnFirstError" @onchange="e => _stopOnFirstError = (bool)(e.Value ?? false)" />
            <label class="field-label" for="stopfirst" style="margin:0">Stop on first error</label>
        </div>
    </div>
</div>

<div class="card">
    <p class="card-title">The batch API</p>
    <pre class="code">@Snippet</pre>
</div>

@code {
    private BatchResult? _result;
    private int _maxEdge = 1600;
    private int _concurrency = 2;
    private ImageFormat _format = ImageFormat.WebP;
    private bool _grayscale;
    private bool _stopOnFirstError;
    private bool _running;
    private int _completed;
    private int _total;
    private string? _error;
    private CancellationTokenSource? _cts;
    private ImageCapabilities? _capabilities;

    private IEnumerable<ImageFormat> AvailableFormats
    {
        get
        {
            var candidates = new[] { ImageFormat.WebP, ImageFormat.Avif, ImageFormat.Jpeg, ImageFormat.Png };
            return _capabilities is null ? candidates.Skip(2) : candidates.Where(_capabilities.CanEncode);
        }
    }

    private const string Snippet = """
        var result = await processor.ProcessBatchAsync(items, pipeline, new BatchOptions
        {
            MaxConcurrency   = 2,
            StopOnFirstError = false,        // one bad file must not lose the rest
            ExportOptions    = exportOptions,
            Progress = new Progress<BatchProgress>(p =>
            {
                completed = p.Completed;
                if (p.Last.Error is { } error) Log(p.Last.FileName, error);
            }),
        }, cancellationToken);

        foreach (var item in result.Succeeded) Save(item.Output!);
        foreach (var item in result.Failed)    Report(item.FileName, item.Error!);
        """;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _capabilities = await Capabilities.GetAsync();
        if (!_capabilities.CanEncode(_format)) _format = _capabilities.ChooseEncodableFormat([ImageFormat.WebP, ImageFormat.Jpeg]);
        StateHasChanged();
    }

    private void SetInt(ref int field, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) field = value;
    }

    private void OnFormatChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && Enum.TryParse<ImageFormat>(value, out var format)) _format = format;
    }

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0 || _running) return;
        _error = null;
        _result = null;
        _running = true;
        _total = files.Count;
        _completed = 0;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            // Read every file first so the batch measures processing, not disk. A real upload flow would stream
            // them in instead, but the point here is the concurrency and error behaviour.
            var items = new List<BatchItem>(files.Count);
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(64 * 1024 * 1024, _cts.Token);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms, _cts.Token);
                items.Add(new BatchItem(ms.ToArray(), file.Name));
            }

            var pipeline = ImagePipeline.Create().AutoOrient().MaxSize(_maxEdge, _maxEdge);
            if (_grayscale) pipeline = pipeline.Grayscale();

            var processor = await Processors.GetAsync(_cts.Token);
            _result = await processor.ProcessBatchAsync(items, pipeline, new BatchOptions
            {
                MaxConcurrency = _concurrency,
                StopOnFirstError = _stopOnFirstError,
                ExportOptions = new ImageExportOptions
                {
                    Format = _format,
                    Quality = 0.82,
                    Metadata = MetadataPolicy.Remove,
                    Background = Rgba32.White,
                },
                Progress = new Progress<BatchProgress>(p =>
                {
                    _completed = p.Completed;
                    InvokeAsync(StateHasChanged);
                }),
            }, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            _error = "The batch was stopped.";
        }
        catch (Exception ex)
        {
            _error = Describe(ex);
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task DownloadAll()
    {
        if (_result is null) return;
        foreach (var item in _result.Succeeded)
        {
            await Exporter.DownloadAsync(item.Output!, System.IO.Path.GetFileNameWithoutExtension(item.FileName ?? "image"));
            await Task.Delay(250);
        }
    }

    private static string Format(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.##} MB",
    };

    private static string Describe(Exception ex) => ex switch
    {
        ImageLimitExceededException => "too large",
        ImageDecodeException => "unreadable",
        ImageCapabilityException => "unsupported here",
        _ => ex.GetType().Name,
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
