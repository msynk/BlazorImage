@page "/optimize"
@implements IDisposable
@inject ImageLoader Loader
@inject ImageExporter Exporter
@inject IImageCapabilityProvider Capabilities

<PageTitle>Image optimisation — BlazorImage</PageTitle>

<div class="page-header">
    <h1>Image optimisation</h1>
    <p class="lede">
        The upload pipeline most applications actually need: cap the dimensions, re-encode to a modern format, strip the
        metadata, and see exactly how many bytes that saved. Everything happens on the user's device, so your servers
        never receive the 8 megapixel original.
    </p>
</div>

@if (_error is not null)
{
    <div class="alert alert-error" role="alert">@_error</div>
}

<div class="split">
    <div class="card">
        <ImageDropZone Label="Drop images here, or click to choose them" Multiple="true" OnFilesSelected="OnFilesSelected" />

        @if (_running)
        {
            <div style="margin-top:16px">
                <div class="progress" role="progressbar" aria-valuenow="@((int)(_progress * 100))" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width:@((_progress * 100).ToString("0"))%"></div>
                </div>
                <p class="small muted" style="margin-top:8px; margin-bottom:0">
                    Processing @_completed of @_total…
                    <button class="btn" style="height:26px; padding:0 10px; margin-inline-start:8px" @onclick="Cancel">Stop</button>
                </p>
            </div>
        }

        @if (_results.Count > 0)
        {
            <div class="stat-grid" style="margin-top:18px">
                <div class="stat">
                    <span class="stat-label">Images</span>
                    <span class="stat-value">@_results.Count</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Before</span>
                    <span class="stat-value">@Format(_results.Sum(r => r.OriginalBytes))</span>
                </div>
                <div class="stat">
                    <span class="stat-label">After</span>
                    <span class="stat-value">@Format(_results.Sum(r => r.NewBytes))</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Saved</span>
                    <span class="stat-value good">@SavedPercent%</span>
                </div>
            </div>

            <div class="btn-row" style="margin-top:14px">
                <button class="btn btn-primary" disabled="@_running" @onclick="DownloadAll">Download all</button>
                <button class="btn" disabled="@_running" @onclick="Clear">Clear</button>
            </div>

            <table class="data" style="margin-top:16px">
                <thead>
                    <tr>
                        <th scope="col">File</th>
                        <th scope="col">Size</th>
                        <th scope="col" class="num">Before</th>
                        <th scope="col" class="num">After</th>
                        <th scope="col" class="num">Saved</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in _results)
                    {
                        <tr>
                            <td>@result.Name</td>
                            <td class="mono">@result.Dimensions</td>
                            <td class="num">@Format(result.OriginalBytes)</td>
                            <td class="num">@Format(result.NewBytes)</td>
                            <td class="num" style="color:var(--success)">@result.SavedPercent%</td>
                            <td><button class="btn" style="height:26px; padding:0 10px" @onclick="() => Download(result)">Save</button></td>
                        </tr>
                    }
                    @foreach (var failure in _failures)
                    {
                        <tr>
                            <td>@failure.Name</td>
                            <td colspan="5" style="color:var(--danger)">@failure.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <p class="card-title">Pipeline</p>

        <div class="field">
            <label class="field-label" for="maxdim">Longest edge <span class="field-value">@_maxDimension px</span></label>
            <input id="maxdim" type="range" min="320" max="4096" step="80" value="@_maxDimension" @oninput="e => Set(ref _maxDimension, e)" />
        </div>

        <div class="field">
            <label class="field-label" for="format">Format</label>
            <select id="format" class="bi-select" @onchange="OnFormatChanged">
                @foreach (var format in AvailableFormats)
                {
                    <option value="@format" selected="@(_format == format)">@format.ToString().ToUpperInvariant()</option>
                }
            </select>
        </div>

        @if (_format.IsLossy())
        {
            <div class="field">
                <label class="field-label" for="quality">Quality <span class="field-value">@_quality.ToString("0.00")</span></label>
                <input id="quality" type="range" min="0.3" max="1" step="0.01" value="@_quality" @oninput="OnQualityChanged" />
            </div>
        }

        <div class="field">
            <label class="field-label" for="metadata">Metadata</label>
            <select id="metadata" class="bi-select" @onchange="OnMetadataChanged">
                <option value="Remove" selected="@(_metadata == MetadataPolicy.Remove)">Remove everything</option>
                <option value="StripSensitive" selected="@(_metadata == MetadataPolicy.StripSensitive)">Keep camera, drop location</option>
                <option value="Preserve" selected="@(_metadata == MetadataPolicy.Preserve)">Keep everything</option>
            </select>
        </div>

        <div class="field field-inline">
            <input id="sharpen" type="checkbox" checked="@_sharpen" @onchange="e => _sharpen = (bool)(e.Value ?? false)" />
            <label class="field-label" for="sharpen" style="margin:0">Sharpen after downscaling</label>
        </div>

        <div class="field">
            <label class="field-label" for="concurrency">Concurrency <span class="field-value">@_concurrency</span></label>
            <input id="concurrency" type="range" min="1" max="8" step="1" value="@_concurrency" @oninput="e => Set(ref _concurrency, e)" />
            <span class="small muted">Higher is faster but uses more memory. Two is a safe default on phones.</span>
        </div>
    </div>
</div>

<div class="card">
    <p class="card-title">The code</p>
    <pre class="code">@Snippet</pre>
</div>

@code {
    private sealed record Result(string Name, string Dimensions, long OriginalBytes, long NewBytes, EncodedImage Encoded)
    {
        public int SavedPercent => OriginalBytes == 0 ? 0 : (int)Math.Round(100 - NewBytes * 100.0 / OriginalBytes);
    }

    private sealed record Failure(string Name, string Message);

    private readonly List<Result> _results = [];
    private readonly List<Failure> _failures = [];
    private int _maxDimension = 1920;
    private ImageFormat _format = ImageFormat.WebP;
    private double _quality = 0.82;
    private MetadataPolicy _metadata = MetadataPolicy.Remove;
    private bool _sharpen = true;
    private int _concurrency = 2;
    private bool _running;
    private int _completed;
    private int _total;
    private double _progress;
    private string? _error;
    private CancellationTokenSource? _cts;
    private ImageCapabilities? _capabilities;

    private int SavedPercent
    {
        get
        {
            var before = _results.Sum(r => r.OriginalBytes);
            var after = _results.Sum(r => r.NewBytes);
            return before == 0 ? 0 : (int)Math.Round(100 - after * 100.0 / before);
        }
    }

    private IEnumerable<ImageFormat> AvailableFormats
    {
        get
        {
            var candidates = new[] { ImageFormat.WebP, ImageFormat.Avif, ImageFormat.Jpeg, ImageFormat.Png };
            return _capabilities is null ? candidates.Skip(2) : candidates.Where(_capabilities.CanEncode);
        }
    }

    private const string Snippet = """
        // One pipeline, reused for every file. Nothing runs until ProcessBatchAsync executes it.
        var pipeline = ImagePipeline.Create()
            .AutoOrient()                       // honour the phone's rotation sensor
            .MaxSize(maxEdge, maxEdge)          // never enlarge, only cap
            .Sharpen(0.3f);                     // recover the bite lost to downscaling

        var result = await processor.ProcessBatchAsync(items, pipeline, new BatchOptions
        {
            MaxConcurrency = 2,
            Progress       = progress,
            ExportOptions  = new ImageExportOptions
            {
                Format   = ImageFormat.WebP,
                Quality  = 0.82,
                Metadata = MetadataPolicy.Remove,
            },
        });
        """;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _capabilities = await Capabilities.GetAsync();
        if (!_capabilities.CanEncode(_format)) _format = _capabilities.ChooseEncodableFormat([ImageFormat.WebP, ImageFormat.Jpeg]);
        StateHasChanged();
    }

    private void Set(ref int field, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) field = value;
    }

    private void OnQualityChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
            _quality = value;
    }

    private void OnFormatChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && Enum.TryParse<ImageFormat>(value, out var format)) _format = format;
    }

    private void OnMetadataChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && Enum.TryParse<MetadataPolicy>(value, out var policy)) _metadata = policy;
    }

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0 || _running) return;
        Clear();
        _running = true;
        _total = files.Count;
        _completed = 0;
        _progress = 0;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        var pipeline = ImagePipeline.Create()
            .AutoOrient()
            .MaxSize(_maxDimension, _maxDimension);
        if (_sharpen) pipeline = pipeline.Sharpen(0.3f);

        var exportOptions = new ImageExportOptions
        {
            Format = _format,
            Quality = _quality,
            Metadata = _metadata,
            Background = Rgba32.White,
        };

        try
        {
            // Files are read one at a time so a large drop does not pull every byte into memory at once.
            foreach (var file in files)
            {
                _cts.Token.ThrowIfCancellationRequested();
                try
                {
                    using var source = await Loader.LoadAsync(file, new DecodeOptions { FileName = file.Name }, _cts.Token);
                    var dimensions = $"{source.Width}×{source.Height}";
                    using var processed = await pipeline.ExecuteAsync(source, new PipelineExecutionOptions { CancellationToken = _cts.Token });
                    var encoded = await Exporter.EncodeAsync(processed, exportOptions, _cts.Token);
                    _results.Add(new Result(file.Name, $"{dimensions} → {processed.Width}×{processed.Height}", file.Size, encoded.Length, encoded));
                }
                catch (OperationCanceledException)
                {
                    throw;
                }
                catch (Exception ex)
                {
                    _failures.Add(new Failure(file.Name, Describe(ex)));
                }
                _completed++;
                _progress = _completed / (double)_total;
                StateHasChanged();
                // Yield so the progress bar actually paints between files.
                await Task.Yield();
            }
        }
        catch (OperationCanceledException)
        {
            _error = "Processing was stopped.";
        }
        catch (Exception ex)
        {
            _error = Describe(ex);
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task Download(Result result)
    {
        try
        {
            await Exporter.DownloadAsync(result.Encoded, System.IO.Path.GetFileNameWithoutExtension(result.Name));
        }
        catch (Exception ex)
        {
            _error = Describe(ex);
        }
    }

    private async Task DownloadAll()
    {
        foreach (var result in _results)
        {
            await Download(result);
            // Browsers throttle rapid successive downloads; a short gap keeps them all.
            await Task.Delay(250);
        }
    }

    private void Clear()
    {
        _results.Clear();
        _failures.Clear();
        _error = null;
    }

    private static string Format(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.##} MB",
    };

    private static string Describe(Exception ex) => ex switch
    {
        ImageLimitExceededException => "Too large to process here.",
        ImageDecodeException => "Not a readable image.",
        ImageCapabilityException c => c.Message,
        _ => ex.Message,
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
