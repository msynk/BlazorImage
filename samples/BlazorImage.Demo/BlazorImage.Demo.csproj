<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>BlazorImage.Demo</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Pixel loops run 10-35x slower on the WebAssembly interpreter than compiled. AOT applies on publish only, so
         `dotnet run` still uses the interpreter; see docs/performance.md. Requires the wasm-tools workload. -->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BlazorImage.Editor/BlazorImage.Editor.csproj" />
  </ItemGroup>
</Project>
